{
  "name": "vanguardia-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API y procesos en segundo plano de Vanguardia",
  "type": "commonjs",
  "main": "src/server.js",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "worker": "node --env-file-if-exists=.env src/worker.js",
    "test": "NODE_OPTIONS='--experimental-vm-modules --disable-warning=ExperimentalWarning' jest --runInBand",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules --disable-warning=ExperimentalWarning' jest --runInBand --watch",
    "lint": "eslint .",
    "format": "prettier --write \"{src,test,scripts,infra,.github}/**/*.{js,json,yml}\" \"*.{js,json,yml}\" README.md",
    "format:check": "prettier --check \"{src,test,scripts,infra,.github}/**/*.{js,json,yml}\" \"*.{js,json,yml}\" README.md",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "db:seed": "sequelize-cli db:seed:all",
    "db:reset": "node scripts/reiniciar-base.js && sequelize-cli db:migrate && sequelize-cli db:seed:all",
    "openapi": "node --env-file-if-exists=.env scripts/generar-openapi.js",
    "infra:up": "node scripts/infra.js up",
    "infra:down": "node scripts/infra.js down"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@aws-sdk/client-s3": "^3.1171.0",
    "@aws-sdk/s3-request-presigner": "^3.1171.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "argon2": "^0.45.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "firebase-admin": "^14.5.1",
    "helmet": "^8.3.0",
    "json-logic-js": "^2.0.5",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.2",
    "pg-hstore": "^2.3.4",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "sequelize": "^6.37.8",
    "sharp": "^0.35.5",
    "swagger-ui-express": "^5.0.1",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.3.2"
  }
}
