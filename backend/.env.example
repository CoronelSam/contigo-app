# Copia este archivo a .env y ajusta los valores. Nunca subas .env al repositorio.
# Desarrollo local sin Docker: PostgreSQL de Homebrew y archivos en una carpeta local.

# --- General
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Solo en desarrollo: registra el SQL de Sequelize (puede incluir datos personales).
LOG_SQL=false

# --- Base de datos (PostgreSQL local; pnpm db:crear crea el rol y las dos bases)
DATABASE_URL=postgres://vanguardia:vanguardia@localhost:5432/vanguardia
DATABASE_URL_TEST=postgres://vanguardia:vanguardia@localhost:5432/vanguardia_test
# Conexión de administrador que usa pnpm db:crear. Por defecto, la base "postgres" con tu usuario
# del sistema (el superusuario de Homebrew).
# ADMIN_DATABASE_URL=postgres://localhost:5432/postgres

# --- Datos de demostración (pnpm db:seed:demo, nunca en producción)
# Contraseña de los usuarios *.demo@vanguardia.test. Al menos 10 caracteres.
SEED_DEMO_CONTRASENA=cambia-esta-contrasena-demo

# --- Autenticación
# Al menos 32 caracteres aleatorios. Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=cambia-esto-por-un-secreto-aleatorio-de-al-menos-32-caracteres
JWT_ACCESS_TTL=15m
REFRESH_TTL_DIAS=30

# --- Almacenamiento de archivos (disco | s3 | memoria)
# disco: carpeta local con URL firmadas que sirve la propia API (solo desarrollo).
# s3: obligatorio en producción. memoria: pruebas automáticas.
ALMACENAMIENTO_PROVEEDOR=disco
ALMACENAMIENTO_DIRECTORIO=tmp/almacenamiento
URL_FIRMADA_SEGUNDOS=300
# Tamaño máximo de cada archivo subido (fotos, PDF, adjuntos), en MB.
ARCHIVOS_MAX_MB=10
# Solo con ALMACENAMIENTO_PROVEEDOR=s3:
# S3_ENDPOINT=https://s3.ejemplo.com
# S3_ENDPOINT_PUBLICO=
# S3_REGION=us-east-1
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_FORCE_PATH_STYLE=false

# --- Cola de trabajos (pgboss | memoria). En pruebas se usa memoria.
COLA_PROVEEDOR=pgboss

# --- Correo (smtp | simulado)
# simulado: no envía nada (útil sin servidor de correo).
# Para ver los correos en desarrollo: brew install mailpit && brew services start mailpit,
# y usa smtp con localhost:1025 (bandeja en http://localhost:8025).
CORREO_PROVEEDOR=simulado
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_SEGURO=false
# SMTP_USER=
# SMTP_PASS=
CORREO_REMITENTE=Vanguardia <no-responder@vanguardia.test>

# --- Notificaciones push (fcm | simulado)
PUSH_PROVEEDOR=simulado
# Cuenta de servicio de Firebase en JSON codificado en base64. Solo si PUSH_PROVEEDOR=fcm.
FCM_CREDENCIALES_JSON_BASE64=

# --- OCR (simulado | tesseract | nube)
OCR_PROVEEDOR=simulado

# --- HTTP
# Dirección con la que el teléfono llega a la API. Se usa en las URL firmadas del almacenamiento
# en disco. Simulador de iOS: http://localhost:3000. Emulador de Android: http://10.0.2.2:3000.
# Teléfono físico: http://<IP de tu Mac en la red>:3000
API_URL_PUBLICA=http://localhost:3000
# Orígenes permitidos separados por coma. La app móvil no necesita CORS.
CORS_ORIGENES=
# Número de proxies inversos delante de la API (para la IP real en límites y auditoría). 0 = ninguno.
TRUST_PROXY=0
# Base de los enlaces que abren la app (deep links) en correos y notificaciones.
APP_ENLACE_BASE=vanguardia://
# Expone /openapi.json y /docs.
DOCS_HABILITADAS=true
